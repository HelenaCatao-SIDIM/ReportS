/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model client_users {
  id                 BigInt   @id @default(autoincrement())
  client_id          BigInt
  external_user_id   String?  @db.VarChar
  nome               String?  @db.VarChar
  telefone           String?  @db.VarChar
  cargo              String?  @db.VarChar
  cpf                String?  @db.VarChar
  estado             String   @default("confirmado") @db.VarChar
  origem             String   @default("painel_sinc") @db.VarChar
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)
  cbo_codigo         String?  @db.VarChar
  cbo_titulo         String?  @db.VarChar
  setor              String?  @db.VarChar
  criado_por_user_id BigInt?
  clients            clients  @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_91818ac2d3")

  @@unique([client_id, cpf], map: "index_client_users_cpf_por_sistema_do_cliente", where: raw("((cpf IS NOT NULL) AND ((estado)::text <> 'unido'::text))"))
  @@unique([client_id, external_user_id], map: "index_client_users_on_client_id_and_external_user_id")
  @@index([client_id], map: "index_client_users_on_client_id")
  @@index([cpf], map: "index_client_users_on_cpf")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model clients {
  id                 BigInt         @id @default(autoincrement())
  customer_id        BigInt?
  sistema            String         @db.VarChar
  tenant_id          String?        @db.VarChar
  estado             String         @default("sem_cliente") @db.VarChar
  ligado_em          DateTime?      @db.Timestamp(6)
  ligado_por_user_id BigInt?
  ligacao_forma      String?        @db.VarChar
  unido_a_id         BigInt?
  tenant_id_unido    String?        @db.VarChar
  nome_antigo        String?        @db.VarChar
  created_at         DateTime       @default(now()) @db.Timestamp(6)
  updated_at         DateTime       @default(now()) @db.Timestamp(6)
  client_users       client_users[]
  customers          customers?     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_acf7e073e4")
  clients            clients?       @relation("clientsToclients", fields: [unido_a_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_cd382d746f")
  other_clients      clients[]      @relation("clientsToclients")

  @@unique([sistema, tenant_id], map: "index_clients_on_sistema_and_tenant_id", where: raw("(tenant_id IS NOT NULL)"))
  @@index([customer_id], map: "index_clients_on_customer_id")
  @@index([estado], map: "index_clients_on_estado")
  @@index([unido_a_id], map: "index_clients_on_unido_a_id")
}


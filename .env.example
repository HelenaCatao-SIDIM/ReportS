# Copie este arquivo para .env.local e preencha os valores (o .env.local não vai para o Git).
# Em produção, o .env.local fica só no servidor (modo 600); veja "Publicação" no README.

# Chave que assina a sessão de login. Use um texto aleatório longo; para gerar um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Endereço do sistema, usado nos links dos e-mails de aprovação.
APP_URL=http://localhost:3000

# Os dois bancos, com o mesmo usuário `reports` (README, "Como rodar no seu computador").
REPORTS_DATABASE_URL=postgresql://reports:senha-dev@localhost:5432/reports_development
PLATAFORMA_DATABASE_URL=postgresql://reports:senha-dev@localhost:5432/plataforma_development

# Endereço do SINC (Esqueci minha senha e aviso da tela "Usuários e permissões").
# Em produção, defina antes do `npm run build`: a tela de login é gerada no build.
SINC_URL=http://localhost:3001

# Pasta das fotos, assinaturas e PDFs (em produção: fora do projeto, por exemplo /var/lib/reports/arquivos).
ARQUIVOS_DIR=./tmp/arquivos

# Opcional — login do participante no SIDIM Saúde, na tela de presença (antes da assinatura). Desligado por padrão.
# Uma chave só, para todos os clientes do Saúde. O endereço da API de cada um vem do diretório de servidores do Saúde
# (o tenant do cliente é comparado com a pasta da logo de cada servidor): não há variável por cliente.
# A senha de cada pessoa viaja até a API: o diretório e as APIs são chamados sempre em https:// (http:// vira https://).
# SAUDE_LOGIN_PARTICIPANTE=true
# Só para testar com um diretório falso (o padrão é o da SIDIM):
# SAUDE_SERVIDORES_URL=https://sidim.no-ip.net/servidores_saude/api/servidorsaude

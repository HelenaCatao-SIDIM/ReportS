# /etc/systemd/system/reports-cnes.service — importa do CNES os estabelecimentos das prefeituras ainda sem nenhum.
# Disparado pelo reports-cnes.timer. É o que faz cliente novo vindo do SINC "puxar sozinho" (o SINC não avisa quando
# entra cliente). Nomes ambíguos ou não-prefeitura ficam de fora; esses dependem do botão na tela.
[Unit]
Description=ReportS: estabelecimentos das prefeituras pelo CNES
After=network.target postgresql.service

[Service]
Type=oneshot
User=reports
WorkingDirectory=/var/www/reports
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/usr/bin/env npm run -s cnes:importar

# /etc/systemd/system/reports-ceps.service — converte em CEP as coordenadas que ficaram pendentes.
# Disparado pelo reports-ceps.timer. Só faz algo com LOCALIZACAO_POR_CEP=true no .env.local.
[Unit]
Description=ReportS: CEPs pendentes das visitas
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ReportS
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run -s ceps:preencher

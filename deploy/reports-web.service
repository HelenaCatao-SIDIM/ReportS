# /etc/systemd/system/reports-web.service — o ReportS (Next.js) atrás do nginx.
# Ajuste User e WorkingDirectory se o servidor usar outros (os mesmos do SINC).
# As variáveis ficam em .env.local, na pasta do projeto (fora do Git).
[Unit]
Description=ReportS (SIDIM Visitas)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ReportS
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npx next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
